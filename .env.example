# OpenRouter API Key
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Default model to use for OpenRouter (e.g., anthropic/claude-3.5-sonnet)
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Kalshi API Credentials (Required for live trading)
KALSHI_API_KEY_ID=your-kalshi-key-id
KALSHI_PRIVATE_KEY=your-kalshi-private-key

# Anthropic API Key (Deprecated in favor of OpenRouter, but kept for core service migration if needed)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
